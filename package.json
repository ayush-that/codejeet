{
  "name": "codejeet-frontend",
  "version": "0.6.9",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/build-data.ts && tsx scripts/verify-dashboard-data.ts && tsx scripts/build-blog.ts && tsx scripts/build-learn.ts && tsx scripts/build-system-design.ts && tsx scripts/build-sitemap.ts",
    "import:data": "node scripts/import-liquidslr.mjs",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' next build --webpack",
    "build:worker": "opennextjs-cloudflare build --minify && tsx scripts/prune-worker-assets.ts && tsx scripts/check-worker-assets.ts",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "pnpm exec tsx scripts/check-worker-assets.ts && opennextjs-cloudflare deploy",
    "upload": "pnpm exec tsx scripts/check-worker-assets.ts && opennextjs-cloudflare upload",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test": "tsx --test --test-concurrency=1 'tests/*.test.ts'",
    "test:workers": "vitest --config vitest.workers.config.mts run",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "knip": "knip",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@clerk/nextjs": "^6",
    "@clerk/themes": "^2.4.57",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@opennextjs/cloudflare": "^1.20.6",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^5.6.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.12.3",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^9.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.19.21",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "4.9.0",
    "husky": "^9.1.7",
    "knip": "6.34.0",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.36.0",
    "oxlint": "1.81.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "dompurify": "^3.4.12",
    "fast-uri": "^3.1.4",
    "postcss": "^8.5.18",
    "prismjs": "^1.30.0",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d"
}
