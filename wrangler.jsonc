{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codejeet",
  "compatibility_date": "2026-02-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.ts",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Backs next/image optimization on Workers (sharp can't run there).
  "images": {
    "binding": "IMAGES",
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "codejeet-next-cache",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codejeet-progress",
      "database_id": "68733624-7cca-48c8-8ee6-710e6791df5c",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_DATA",
        "class_name": "AccountData",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccountData"],
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
