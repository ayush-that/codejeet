# Copy to .env.local for `pnpm dev`. In Coolify, configure these as environment variables.

# --- Clerk (optional; only needed to save progress / notes cloud sync) ---
# The publishable key is required at build and runtime. Keep the secret runtime-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- PostgreSQL (required for signed-in progress and notes) ---
DATABASE_URL=

# Set to 1 only during the final migration sync. Reads remain available.
USER_DATA_READ_ONLY=0

# --- Optional: podcast audio CDN ---
# Public R2 base URL for system-design audiobook playback. App works without it.
NEXT_PUBLIC_R2_BASE_URL=

# --- Optional: blog generation scripts only (not used by the app runtime) ---
# DEEPSEEK_API_KEY=
# LIQUIDSLR_DIR=
